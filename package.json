{
	"name": "deion-portfolio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"blog:sync": "node scripts/sync-blog.mjs",
		"prebuild": "npm run blog:sync",
		"predev": "npm run blog:sync",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"dev": "next dev",
		"lint": "biome lint src scripts",
		"preview": "npm run build && serve out --listen tcp://127.0.0.1:3000",
		"setup:hooks": "node scripts/install-hooks.mjs",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@strapi/blocks-react-renderer": "1.0.2",
		"@t3-oss/env-nextjs": "^0.12.0",
		"lucide-react": "^1.53.0",
		"next": "^16.3.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"server-only": "0.0.1",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.14.10",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8.5.3",
		"serve": "14.2.6",
		"tailwindcss": "^4.0.15",
