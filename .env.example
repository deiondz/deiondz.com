STRAPI_URL=https://strapi.deiondz.com
# Server/build-only token. Never use a NEXT_PUBLIC_ prefix.
STRAPI_READ_TOKEN=
PREVIEW_SECRET=
# Dedicated server-to-server secret; must match the Strapi subscription extension.
BLOG_SUBSCRIPTIONS_INTERNAL_SECRET=
# Optional loopback CMS URL on the production host.
STRAPI_INTERNAL_URL=

# Guestbook (Better Auth + SQLite). Server-only; never prefix with NEXT_PUBLIC_.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and .../google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to .data/guestbook.db. Production: /var/www/deiondz.com/data/guestbook.db
GUESTBOOK_DATABASE_PATH=
# Comma-separated emails that can pin and delete any message.
GUESTBOOK_ADMIN_EMAILS=
